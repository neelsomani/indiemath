{
  "name": "indiemath",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#indiemath/admin-cli": "./packages/admin-cli/index.mjs",
    "#indiemath/anthropic": "./packages/anthropic/index.mjs",
    "#indiemath/fakes": "./packages/fakes/index.mjs",
    "#indiemath/frontend": "./packages/frontend/index.mjs",
    "#indiemath/intake-publisher": "./packages/intake-publisher/index.mjs",
    "#indiemath/ledger": "./packages/ledger/index.mjs",
    "#indiemath/open-collective": "./packages/open-collective/index.mjs",
    "#indiemath/r2": "./packages/r2/index.mjs",
    "#indiemath/shared": "./packages/shared/index.mjs",
    "#indiemath/stripe": "./packages/stripe/index.mjs",
    "#indiemath/workers": "./packages/workers/index.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "node scripts/check-foundations.mjs",
    "dev": "node scripts/serve-site.mjs",
    "import:fable-math": "node scripts/import-fable-math-results.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --test scripts/test-*.mjs",
    "test:anthropic-live": "INDIEMATH_RUN_LIVE_ANTHROPIC=confirmed node --env-file=.env --test scripts/test-anthropic-live.mjs",
    "validate": "node scripts/validate-problem-catalog.mjs"
  }
}
