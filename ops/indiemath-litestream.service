[Unit]
Description=IndieMath SQLite replication to Cloudflare R2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=indiemath
Group=indiemath
WorkingDirectory=/opt/indiemath
EnvironmentFile=/etc/indiemath/litestream.env
ExecStart=/opt/indiemath/scripts/replicate-ledger.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/indiemath

[Install]
WantedBy=multi-user.target
