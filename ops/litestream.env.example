# Copy to /etc/indiemath/litestream.env with mode 0600 on the ledger host.
# Never commit the populated file.
INDIEMATH_DB_PATH=/var/lib/indiemath/ledger.sqlite
INDIEMATH_LITESTREAM_META_ROOT=/var/lib/indiemath/litestream

R2_REPLICA_BUCKET=replace-me
R2_ENDPOINT=replace-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

SECONDARY_AWS_REPLICA_BUCKET=replace-me
SECONDARY_AWS_REGION=us-east-1
SECONDARY_AWS_ACCESS_KEY_ID=replace-me
SECONDARY_AWS_SECRET_ACCESS_KEY=replace-me
