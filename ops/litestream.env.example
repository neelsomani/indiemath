# `sudo ./setup-litestream.sh` generates /etc/indiemath/litestream.env with
# mode 0600 from the root .env file or current environment. This remains the
# deployment-layout reference; never commit a populated copy.
INDIEMATH_DB_PATH=/var/lib/indiemath/ledger.sqlite
INDIEMATH_LITESTREAM_META_ROOT=/var/lib/indiemath/litestream

R2_REPLICA_BUCKET=replace-me
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
