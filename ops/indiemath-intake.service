[Unit]
Description=IndieMath Open Collective intake and public ledger publisher
After=network-online.target indiemath-litestream.service
Wants=network-online.target

[Service]
Type=simple
User=indiemath
Group=indiemath
WorkingDirectory=/opt/indiemath/current
EnvironmentFile=/etc/indiemath/indiemath.env
ExecStart=/usr/bin/node /opt/indiemath/current/scripts/run-open-collective-intake.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/indiemath

[Install]
WantedBy=multi-user.target
