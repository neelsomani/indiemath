# Copy this file to .env and fill only the values needed by the process you run.
# Never commit .env or any populated local environment file.

# Local Anthropic Stage 4 live gate.
ANTHROPIC_API_KEY=

# Common service configuration.
INDIEMATH_RUNTIME=production
# Persistent ledger state on the deployment host. Catalog and pricing paths
# resolve from the checked-out repository automatically.
INDIEMATH_DB=/var/lib/indiemath/ledger.sqlite

# Optional operational pause. Set this in the protected production environment
# and rerun the intake/worker setup scripts; remove it and rerun them to resume.
# INDIEMATH_RUNS_PAUSED_REASON=anthropic-monthly-plan-limit

# Select a contiguous fleet from worker-1 through worker-N. Rerun
# `sudo ./setup-workers.sh` after changing this; surplus services are stopped
# and disabled when scaling down. Each active worker needs its own standard
# Anthropic API key, converted into a root-only per-worker service environment.
WORKER_COUNT=4
WORKER_1_ANTHROPIC_API_KEY=
WORKER_2_ANTHROPIC_API_KEY=
WORKER_3_ANTHROPIC_API_KEY=
WORKER_4_ANTHROPIC_API_KEY=

# Cloudflare R2 transcript and publication storage.
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET=

# Private Litestream database-replica bucket.
# Run `sudo ./setup-litestream.sh` on the deployment host after filling these.
R2_REPLICA_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Open Collective intake.
OPEN_COLLECTIVE_SLUG=indiemath
OPEN_COLLECTIVE_GRAPHQL_URL=https://api.opencollective.com/graphql/v2
OPEN_COLLECTIVE_API_TOKEN=
PUBLISH_INTERVAL_SECONDS=30

# Stripe operations: full refundable-net refunds, dispute recovery, and
# independently verified paid-payout reconciliation.
STRIPE_SECRET_KEY=
# Non-secret account identifier shown by Stripe (acct_...). Required only by
# settlement reconciliation; the API health check uses Balance read access.
STRIPE_ACCOUNT_ID=

# Optional Ramp read-only transaction sync. Create a client-credentials API
# application with only transactions:read and use the dedicated Anthropic card
# UUID so unrelated company spend is never included in the public aggregate.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
RAMP_CARD_ID=
RAMP_API_BASE_URL=https://api.ramp.com
RAMP_SYNC_INTERVAL_SECONDS=300

# Public URL for the artifact bucket; fixed object paths are derived in code.
PUBLIC_DATA_BASE_URL=

# Periodic production health checks. Failures are recorded in the structured
# status file, the systemd unit state, and the journal.
PUBLIC_SITE_URL=https://indiemath.ai
MONITOR_MAX_INTAKE_LAG_SECONDS=180
MONITOR_MAX_PUBLICATION_LAG_SECONDS=180
MONITOR_STATUS_PATH=/var/lib/indiemath/monitor-status.json
LAUNCH_EVIDENCE_PATH=/var/lib/indiemath/launch-evidence.json
